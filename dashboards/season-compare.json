            "uid": "eg0dslgx3y0w0b"
          },
          "rawSql": "SELECT over_no AS \"Over\",\n       max(avg_cum_runs) FILTER (WHERE season = 'Spring 2026' AND team = 'Astros+') AS \"Astros+ Spring\",\n       max(avg_cum_runs) FILTER (WHERE season = 'Summer 2026' AND team = 'Astros+') AS \"Astros+ Summer\",\n       max(avg_cum_runs) FILTER (WHERE season = 'Spring 2026' AND team = 'League average') AS \"League avg Spring\",\n       max(avg_cum_runs) FILTER (WHERE season = 'Summer 2026' AND team = 'League average') AS \"League avg Summer\"\nFROM cricket.over_baseline GROUP BY over_no ORDER BY over_no",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
