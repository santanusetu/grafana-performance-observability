        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "eg0dslgx3y0w0b"
          },
          "rawSql": "SELECT initcap(p.phase) AS phase,\n       max(p.run_rate) FILTER (WHERE p.season = 'Spring 2026' AND p.team = 'Astros+') AS \"Astros+ Spring\",\n       max(p.run_rate) FILTER (WHERE p.season = 'Summer 2026' AND p.team = 'Astros+') AS \"Astros+ Summer\",\n       round(avg(p.run_rate) FILTER (WHERE p.season = 'Summer 2026' AND s.top4), 2)  AS \"Top 4, Summer\"\nFROM cricket.team_phase p\nJOIN cricket.team_summary s ON s.season = p.season AND s.team = p.team\nWHERE p.side = 'batting'\nGROUP BY p.phase, p.phase_order ORDER BY p.phase_order",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
