    {
      "type": "barchart",
      "title": "Batting run rate by phase",
      "description": "Runs per over in each phase. Higher is better.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "eg0dslgx3y0w0b"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "eg0dslgx3y0w0b"
          },
          "rawSql": "SELECT initcap(p.phase) || CASE p.phase WHEN 'powerplay' THEN ' (1-6)' WHEN 'middle' THEN ' (7-15)' ELSE ' (16-20)' END AS phase,\n       p.run_rate AS \"Astros+\",\n       round(avg(q.run_rate) FILTER (WHERE s.top4), 2) AS \"Semi-finalists\",\n       round(avg(q.run_rate), 2) AS \"League average\"\nFROM cricket.team_phase p\nJOIN cricket.team_phase q ON q.season = p.season AND q.side = p.side AND q.phase = p.phase\nJOIN cricket.team_summary s ON s.season = q.season AND s.team = q.team\nWHERE p.team = 'Astros+' AND p.side = 'batting' AND p.season = 'Summer 2026'\nGROUP BY p.phase, p.phase_order, p.run_rate\nORDER BY p.phase_order",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
