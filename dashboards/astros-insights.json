        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "eg0dslgx3y0w0b"
          },
          "rawSql": "SELECT b.over_no AS \"Over\",\n       max(b.avg_cum_runs) FILTER (WHERE b.team = 'Astros+') AS \"Astros+\",\n       round(avg(b.avg_cum_runs) FILTER (WHERE s.top4), 1) AS \"Semi-finalists\",\n       max(b.avg_cum_runs) FILTER (WHERE b.team = 'League average') AS \"League average\"\nFROM cricket.over_baseline b\nLEFT JOIN cricket.team_summary s ON s.season = b.season AND s.team = b.team\nWHERE b.season = 'Summer 2026'\nGROUP BY b.over_no ORDER BY b.over_no",
